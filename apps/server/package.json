{
  "name": "@ext-stack/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply ext-stack-db --local",
    "db:clear:local": "rm -rf .wrangler/state/v3/d1",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply ext-stack-db --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ext-stack/auth": "workspace:*",
    "@ext-stack/db": "workspace:*",
    "@hono/zod-validator": "^0.8.0",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "^4.4.0"
  }
}
